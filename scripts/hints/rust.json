{
  "variables_01": {
    "hints": [
      "Use `let age = 25;`",
      "Use `println!(\"{}\", age);` or `println!(\"{age}\");` on Rust 2021+"
    ]
  },
  "variables_02": {
    "hints": [
      "let name = \"Rust\";",
      "let version: f64 = 1.85;",
      "println!(\"{} {}\", name, version);"
    ]
  },
  "variables_03": {
    "hints": [
      "`let y = x as f64;`",
      "println!(\"{}\", y as i32); // or print y with {:.0}"
    ]
  },
  "variables_04": {
    "hints": [
      "println!(\"{} {} {} {}\", 0i32, 0f64, \"\", false);"
    ]
  },
  "variables_05": {
    "hints": [
      "`const MAX_SCORE: i32 = 100;`",
      "`const MIN_SCORE: i32 = 0;`"
    ]
  },
  "variables_07": {
    "hints": [
      "let (host, port, debug) = (\"localhost\", 8080, true);",
      "Types inferred: &str, i32, bool"
    ]
  },
  "variables_06": {
    "hints": [
      "`(a, b) = (b, a);` requires `mut` on bindings.",
      "Or use `std::mem::swap(&mut a, &mut b);`"
    ]
  },
  "ownership_01": {
    "hints": [
      "`let t = s;` moves ownership",
      "`println!(\"{}\", t);`"
    ]
  },
  "ownership_02": {
    "hints": [
      "`let t = s.clone();`",
      "`println!(\"{}{}\", s, t);`"
    ]
  },
  "ownership_03": {
    "hints": [
      "`let mut b = a;` copies `i32`",
      "`b += 1;`"
    ]
  },
  "controlflow_01": {
    "hints": [
      "`if age >= 18 { ... } else { ... }`"
    ]
  },
  "controlflow_02": {
    "hints": [
      "`for i in 1..=5`"
    ]
  },
  "controlflow_03": {
    "hints": [
      "`match day { 1 => ..., 2 => ..., _ => ... }`"
    ]
  },
  "controlflow_04": {
    "hints": [
      "`for c in colors`"
    ]
  },
  "controlflow_05": {
    "hints": [
      "chain `if / else if`"
    ]
  },
  "controlflow_07": {
    "hints": [
      "`if i >= 5 { break; }`"
    ]
  },
  "controlflow_06": {
    "hints": [
      "`if i % 2 == 0 { continue; }`"
    ]
  },
